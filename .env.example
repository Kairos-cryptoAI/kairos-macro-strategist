KAIROS_BUS_BACKEND=redis
KAIROS_REDIS_URL=redis://localhost:6379/0
KAIROS_TRADING_SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT","BNBUSDT","XRPUSDT"]
KAIROS_RUN_CRON_HOUR_UTC=0
KAIROS_CRASH_PCT_1H=10
KAIROS_SHOCK_COOLDOWN_S=3600
KAIROS_PRICE_HISTORY_WINDOW_S=7200
KAIROS_SHOCK_BASELINE_TOLERANCE_S=300
KAIROS_ACCOUNT_HISTORY_WINDOW_S=604800
KAIROS_ACCOUNT_SNAPSHOT_MAX_AGE_S=60
KAIROS_MARKET_SNAPSHOT_MAX_AGE_S=120
KAIROS_MAX_FUTURE_SKEW_S=5
KAIROS_MINIMUM_FRESH_MARKETS=1
KAIROS_SCHEDULER_POLL_S=30
KAIROS_REPLAY_CACHE_SIZE=256
# Exact StrategyIntent.strategy_id values, not strategy families or aliases.
# There are no PAPER_APPROVED strategies: keep empty; technical-canary is forbidden.
KAIROS_ALLOWED_STRATEGY_IDS=[]
# Select one exact account/version when the audit contains more than one scope.
# KAIROS_ACCOUNT_HISTORY_ACCOUNT_ID=dedicated-dev-account-id
# KAIROS_ACCOUNT_HISTORY_VERSION=v2
KAIROS_HISTORY_RESTORE_MAX_ROWS=100000
KAIROS_HISTORY_SAMPLE_LIMIT=100000
# Operational coverage tolerances, not a claim that the producer runs every 120s.
KAIROS_ACCOUNT_HISTORY_MAX_GAP_S=120
KAIROS_MARKET_HISTORY_MAX_GAP_S=120
KAIROS_OPENAI_API_KEY=sk-...
